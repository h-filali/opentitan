(* MaskVerif analysis for otbn_mask_accelerator_sca_wrapper
   First-order Boolean masking: 2 shares.

   Secret inputs — paired per bit across two buses:
     share0_i [511:0]  share 0 of 512 input bits
     share1_i [511:0]  share 1 of the same 512 bits
     Layout of each 512-bit bus (Width=32, VecSize=8, DoubleWidth=64):
       element k occupies bits [k*64 +: 64] = { b_share[k][31:0], a_share[k][31:0] }

   Randomness:
     rand_i [385:0]  adder randomness [321:0] ++ arithmetic masks [385:322]

   Secret outputs — two-share output word:
     sum_o [63:0]   share0 = [31:0],  share1 = [63:32]

   Public (control):
     clk_i, rst_ni, wvalid_i, wready_o, rvalid_o,
     q_i [31:0], mask_op_i [4:0], mask_fifo_err_o, ctr_err_o

   To generate the annotated ilang file required by this script run:
     ./gen_annot_ilang.sh

   Run from ~/maskverif:
     ./maskverif < ~/opentitan/hw/ip/otbn/pre_sca/maskverif/verify_sec_add.mv
*)

read_ilang ../opentitan/hw/ip/otbn/pre_syn/ilang_out/otbn_mask_accelerator_sca_wrapper_annot.ilang

verbose 1

(* Check probing security without glitches *)
noglitch Probing \otbn_mask_accelerator_sca_wrapper

(* Check probing security with glitch propagation *)
Probing \otbn_mask_accelerator_sca_wrapper

(* Non-interference *)
noglitch NI \otbn_mask_accelerator_sca_wrapper

(* Strong non-interference *)
noglitch SNI \otbn_mask_accelerator_sca_wrapper

(* Parallel verification — recommended for this design size *)
para noglitch NI \otbn_mask_accelerator_sca_wrapper
